# Database Configuration
DATABASE_URL="file:./prod.db"

# Email Configuration (Use environment variables on VPS)
GMAIL_USER=your_production_email@gmail.com
GMAIL_APP_PASSWORD=your_production_app_password
NOTIFICATION_EMAIL=info@smartsparkservices.com

# Integration URLs
N8N_WEBHOOK_URL=https://n8n.smartsparkservices.com/webhook/contact-form
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Authentication (Generate strong secrets for production)
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters
NEXTAUTH_SECRET=your-super-secure-nextauth-secret-minimum-32-characters
NEXTAUTH_URL=https://smartsparkservices.com

# Production URLs
PRODUCTION_URL=https://smartsparkservices.com
PRODUCTION_N8N=https://n8n.smartsparkservices.com

# Security
NODE_ENV=production